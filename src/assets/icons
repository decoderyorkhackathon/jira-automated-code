import React, { useState, useEffect } from 'react';

// Importing weather icons
import { WiDaySunny, WiNightClear, WiRain, WiSnow, WiCloudy } from 'react-icons/wi';

const WeatherVisual = () => {
  const [weather, setWeather] = useState('sunny');

  // Simulating dynamic weather change
  useEffect(() => {
    const weatherTypes = ['sunny', 'night', 'rainy', 'snowy', 'cloudy'];
    const interval = setInterval(() => {
      setWeather(weatherTypes[Math.floor(Math.random() * weatherTypes.length)]);
    }, 5000);
    return () => clearInterval(interval);
  }, []);

  const getWeatherIcon = () => {
    switch (weather) {
      case 'sunny':
        return <WiDaySunny className="text-9xl text-yellow-500 animate-pulse" />;
      case 'night':
        return <WiNightClear className="text-9xl text-blue-700 animate-pulse" />;
      case 'rainy':
        return <WiRain className="text-9xl text-blue-500 animate-pulse" />;
      case 'snowy':
        return <WiSnow className="text-9xl text-gray-400 animate-pulse" />;
      case 'cloudy':
        return <WiCloudy className="text-9xl text-gray-500 animate-pulse" />;
      default:
        return <WiDaySunny className="text-9xl text-yellow-500 animate-pulse" />;
    }
  };

  const getBackgroundClass = () => {
    switch (weather) {
      case 'sunny':
        return 'bg-yellow-200';
      case 'night':
        return 'bg-blue-900';
      case 'rainy':
        return 'bg-blue-400';
      case 'snowy':
        return 'bg-gray-200';
      case 'cloudy':
        return 'bg-gray-400';
      default:
        return 'bg-yellow-200';
    }
  };

  return (
    <div className={`h-screen w-screen flex items-center justify-center ${getBackgroundClass()}`}>
      {getWeatherIcon()}
    </div>
  );
};

export default WeatherVisual;
```

This code creates a React component that simulates dynamic weather changes. It uses Tailwind CSS for styling and react-icons for weather icons. The weather state changes every 5 seconds, and the background color and icon change accordingly.